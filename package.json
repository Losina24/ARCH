{
  "name": "arch",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "link:global": "(cd packages/cli && pnpm link --global) && (cd packages/tui && pnpm link --global)",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
