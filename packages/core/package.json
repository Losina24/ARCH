{
  "name": "@losina/core",
  "version": "0.2.0",
  "description": "DAG, git, and state helpers shared across ARCH packages.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
