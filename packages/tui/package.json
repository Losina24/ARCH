{
  "name": "@losina/arch-terminal",
  "version": "0.2.0",
  "description": "arch-terminal — the ARCH terminal UI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "arch-terminal": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Losina24/ARCH.git",
    "directory": "packages/tui"
  },
  "homepage": "https://github.com/Losina24/ARCH#readme",
  "bugs": "https://github.com/Losina24/ARCH/issues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@losina/agent-runtime": "workspace:*",
    "@losina/config": "workspace:*",
    "@losina/core": "workspace:*",
    "@losina/daemon-client": "workspace:*",
    "@losina/ipc": "workspace:*",
    "@losina/schemas": "workspace:*",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
