{
  "name": "@losina/arch-cli",
  "version": "0.1.1",
  "description": "archctl — the ARCH orchestration CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archctl": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Losina24/ARCH.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Losina24/ARCH#readme",
  "bugs": "https://github.com/Losina24/ARCH/issues",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@losina/config": "workspace:*",
    "@losina/core": "workspace:*",
    "@losina/daemon": "workspace:*",
    "@losina/daemon-client": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
