{
  "name": "@arch/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "archctl": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/bin.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@arch/config": "workspace:*",
    "@arch/daemon": "workspace:*",
    "@arch/daemon-client": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
